# URL canonique du site (sert au sitemap et aux balises SEO)
SITE_URL="https://www.amour2poils.fr"

# --- Formulaire de contact ---
# Clé API Resend (https://resend.com/api-keys).
# Si elle est absente, le formulaire fonctionne en mode "dry run" :
# le message est validé et journalisé, mais aucun e-mail n'est envoyé.
RESEND_API_KEY=""

# Boîte qui reçoit les demandes du formulaire
CONTACT_TO_EMAIL="contact@amour2poils.fr"

# Expéditeur affiché — le domaine doit être vérifié chez Resend
CONTACT_FROM_EMAIL="Site Amour 2 Poils <site@amour2poils.fr>"
